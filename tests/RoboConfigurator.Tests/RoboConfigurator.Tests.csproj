<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests unitaires de la logique pure : rien de ce projet n'est intégré à RoboConfigurator.exe -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Versions exactes de toutes les dépendances (packages.lock.json), imposées en CI -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicite : le SDK ne l'ajoute que sur les PC sans pack de ciblage .NET 4.7.2, ce qui rendait packages.lock.json
         différent selon la machine. Assemblies de référence pour la compilation seulement, rien dans l'exe. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoboConfigurator\RoboConfigurator.csproj" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
