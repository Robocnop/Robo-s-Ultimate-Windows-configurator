<ui:FluentWindow
    x:Class="RoboConfigurator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RoboConfigurator"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Robo's Ultimate Windows Configurator"
    Width="980"
    Height="820"
    MinWidth="700"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:SymbolToIconConverter x:Key="SymbolToIcon" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Footer" TargetType="Border">
            <Setter Property="Padding" Value="40,14" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Robo's Ultimate Windows Configurator" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="ConfigView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Margin="40,4,40,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{local:T 'Configure this PC', 'Configuration du poste'}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Secondary}"
                        Text="{local:T 'Set everything up here, then click Start: the setup then runs on its own until the end.', 'Réglez tout ici puis cliquez sur Démarrer : la configuration se déroule ensuite seule jusqu’à la fin.'}" />

                    <Border Margin="0,20,0,0" Padding="20" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="64"
                                Height="64"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="8">
                                <ui:SymbolIcon
                                    FontSize="34"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Symbol="Laptop24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="PcNameText"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="PcModelText" Style="{StaticResource Secondary}" Text="{local:T 'Reading PC information...', 'Lecture des informations du poste...'}" />
                                <TextBlock x:Name="WindowsText" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="ActivationIcon" FontSize="20" Symbol="ShieldQuestion24" />
                                <TextBlock
                                    x:Name="ActivationText"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ui:InfoBar x:Name="ConfigMessage" Margin="0,12,0,0" IsClosable="True" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:T 'PC', 'Poste'}" />
                    <ui:CardControl Icon="{ui:SymbolIcon Rename24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'PC name', 'Nom du PC'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'Applied on restart. Up to 15 characters: letters, digits and hyphens. Leave empty to keep the current name.', 'Appliqué au redémarrage. 15 caractères maximum : lettres, chiffres et tirets. Vide = garder le nom actuel.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:TextBox
                            x:Name="NewNameBox"
                            Width="240"
                            CharacterCasing="Upper"
                            MaxLength="15" />
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:T 'Steps', 'Étapes'}" />
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StepItem}">
                                <ui:CardControl Margin="0,0,0,4" Icon="{Binding Icon, Converter={StaticResource SymbolToIcon}}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding AlreadyDone, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                        Text="{local:T 'Already done', 'Déjà faite'}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding IsSelected}"
                                        OffContent="{local:T 'Off', 'Désactivé'}"
                                        OnContent="{local:T 'On', 'Activé'}" />
                                </ui:CardControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Options" />
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Options24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'CrapFixer tweaks', 'Tweaks CrapFixer'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'Settings applied by the CrapFixer step. Dark theme is always applied.', 'Réglages appliqués par l’étape CrapFixer. Le thème sombre est toujours appliqué.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="TweaksBox" Width="240" SelectedIndex="0">
                            <ComboBoxItem Content="{local:T 'Recommended', 'Recommandés'}" />
                            <ComboBoxItem Content="{local:T 'All', 'Tous'}" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Key24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'Windows product key', 'Clé de produit Windows'}" />
                                <TextBlock x:Name="KeyHint" Style="{StaticResource Secondary}" Text="{local:T 'Only installed if Windows is not already activated.', 'Installée seulement si Windows n’est pas déjà activé.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:TextBox
                            x:Name="KeyBox"
                            Width="320"
                            CharacterCasing="Upper"
                            FontFamily="Cascadia Mono, Consolas"
                            MaxLength="29"
                            PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Window24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'Windows edition', 'Édition de Windows'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'Used by the activation step. Home to Pro is done in place (restart needed, then run the app again); Pro to Home needs a reinstall.', 'Utilisée par l’étape Activation. Famille vers Pro se fait sur place (redémarrage nécessaire, puis relancer l’application) ; Pro vers Famille demande une réinstallation.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="EditionBox" Width="240" SelectedIndex="0">
                            <ComboBoxItem Content="{local:T 'Keep the current one', 'Garder l’actuelle'}" />
                            <ComboBoxItem Content="Windows Pro" />
                            <ComboBoxItem Content="{local:T 'Windows Home', 'Windows Famille'}" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon ArrowClockwise24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'Restart when done', 'Redémarrer à la fin'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'The PC restarts 60 seconds after the end. The restart can be cancelled from the app.', 'Le PC redémarre 60 secondes après la fin. Le redémarrage peut être annulé depuis l’application.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch
                            x:Name="RestartSwitch"
                            IsChecked="True"
                            OffContent="{local:T 'Off', 'Désactivé'}"
                            OnContent="{local:T 'On', 'Activé'}" />
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon Delete24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'Clean up when done', 'Nettoyer à la fin'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'Deletes the working folder (downloads, settings, log) before restarting. It is kept if a step fails. The report stays on the desktop.', 'Supprime le dossier de travail (téléchargements, configuration, journal) avant le redémarrage. Il est conservé si une étape échoue. Le rapport reste sur le Bureau.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch
                            x:Name="CleanUpSwitch"
                            IsChecked="True"
                            OffContent="{local:T 'Off', 'Désactivé'}"
                            OnContent="{local:T 'On', 'Activé'}" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon DeleteDismiss24}" IsEnabled="{Binding IsChecked, ElementName=CleanUpSwitch}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:T 'Clean up even if a step fails', 'Nettoyer même en cas d’erreur'}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{local:T 'Deletes the working folder even when a step failed: the failed steps can then not be resumed. A copy of the log stays on the desktop.', 'Supprime le dossier de travail même si une étape a échoué : les étapes en échec ne pourront plus être reprises. Une copie du journal reste sur le Bureau.'}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch
                            x:Name="CleanUpOnErrorSwitch"
                            IsChecked="False"
                            OffContent="{local:T 'Off', 'Désactivé'}"
                            OnContent="{local:T 'On', 'Activé'}" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource Footer}">
                <Grid>
                    <ui:Button
                        x:Name="ResetButton"
                        HorizontalAlignment="Left"
                        Click="OnResetClick"
                        Content="{local:T 'Start over', 'Tout recommencer'}"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        ToolTip="{local:T 'Forgets completed steps and the saved settings', 'Oublie les étapes déjà faites et la configuration enregistrée'}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            x:Name="SimulationBadge"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{local:T 'Simulation mode: nothing will be changed', 'Mode simulation : aucune modification ne sera faite'}"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="StartButton"
                            MinWidth="150"
                            Appearance="Primary"
                            Click="OnStartClick"
                            Content="{local:T 'Start', 'Démarrer'}"
                            Icon="{ui:SymbolIcon Play24}"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="RunView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="RunScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Margin="40,4,40,28">
                    <TextBlock x:Name="RunTitle" Style="{StaticResource PageTitle}" Text="{local:T 'Setting up', 'Configuration en cours'}" />
                    <TextBlock
                        x:Name="RunSubtitle"
                        Margin="0,4,0,0"
                        Style="{StaticResource Secondary}"
                        Text="{local:T 'The PC is setting itself up. Only Ninite asks you to click “Close” when it finishes.', 'Le PC se configure tout seul. Seul Ninite demande de cliquer sur « Close » à la fin de son installation.'}" />
                    <ProgressBar x:Name="OverallProgress" Margin="0,20,0,0" />

                    <ui:InfoBar x:Name="RunMessage" Margin="0,16,0,0" IsClosable="False" />

                    <ItemsControl x:Name="RunList" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StepItem}">
                                <Border Margin="0,0,0,4" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            FontSize="22"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="{Binding Icon}" />
                                        <Grid
                                            Grid.Column="1"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon
                                                x:Name="StatusIcon"
                                                FontSize="22"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Symbol="{Binding StatusSymbol}" />
                                            <ui:ProgressRing
                                                x:Name="Ring"
                                                Width="22"
                                                Height="22"
                                                IsIndeterminate="True"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="StatusLabel"
                                            Grid.Column="3"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding StatusText}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="AlreadyDone">
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:CardExpander
                        Margin="0,12,0,0"
                        Header="{local:T 'Detailed log', 'Journal détaillé'}"
                        Icon="{ui:SymbolIcon DocumentText24}">
                        <TextBox
                            x:Name="LogBox"
                            Height="280"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource Footer}">
                <Grid>
                    <ui:Button
                        x:Name="OpenFolderButton"
                        HorizontalAlignment="Left"
                        Click="OnOpenFolderClick"
                        Content="{local:T 'Open folder', 'Ouvrir le dossier'}"
                        Icon="{ui:SymbolIcon Folder24}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            x:Name="OpenReportButton"
                            Margin="0,0,8,0"
                            Click="OnOpenReportClick"
                            Content="{local:T 'Open report', 'Ouvrir le rapport'}"
                            Icon="{ui:SymbolIcon DocumentBulletList24}"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="CancelRestartButton"
                            Margin="0,0,8,0"
                            Click="OnCancelRestartClick"
                            Content="{local:T 'Cancel restart', 'Annuler le redémarrage'}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="CloseButton"
                            Margin="0,0,8,0"
                            Click="OnCloseClick"
                            Content="{local:T 'Close', 'Fermer'}"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="RestartNowButton"
                            Appearance="Primary"
                            Click="OnRestartNowClick"
                            Content="{local:T 'Restart now', 'Redémarrer maintenant'}"
                            Icon="{ui:SymbolIcon Power24}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
