<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.7.2+ est fourni avec Windows 10 (1803+) et 11 : rien à installer sur le PC à configurer -->
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- Versions exactes de toutes les dépendances (packages.lock.json), imposées en CI -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Processus 64 bits sur Windows 64 bits : sinon le registre HKLM\SOFTWARE serait redirigé vers WOW6432Node -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>RoboConfigurator</AssemblyName>
    <RootNamespace>RoboConfigurator</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.7.0</Version>
    <Product>Robo's Ultimate Windows Configurator</Product>
    <AssemblyTitle>Robo's Ultimate Windows Configurator</AssemblyTitle>
    <Company>Robocnop</Company>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- En Debug, pas de demande administrateur : permet de tester l'interface avec -Simulation -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicite : le SDK ne l'ajoute que sur les PC sans pack de ciblage .NET 4.7.2, ce qui rendait packages.lock.json
         différent selon la machine. Assemblies de référence pour la compilation seulement, rien dans l'exe. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RoboConfigurator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\AppIcons\*.png" />
    <!-- Fichiers optionnels déposés dans payloads\ : intégrés à l'exe pour fonctionner sans Internet -->
    <EmbeddedResource Include="..\..\payloads\*.exe;..\..\payloads\*.zip;..\..\payloads\*.cmd" LogicalName="Payload.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
